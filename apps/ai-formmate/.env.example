# ---------------------------------------------------------------------------
# AI FormMate — environment variables
# Copy to `.env.local` and fill in real values. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Public origin of the deployment. Used to build auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (public — safe to expose to the browser) ---------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server only — NEVER prefix with NEXT_PUBLIC_) ---------------
# Only used by trusted server code / migrations tooling. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Private storage bucket used by the Document Vault (Phase 3).
SUPABASE_DOCUMENTS_BUCKET=documents

# --- AI provider abstraction (Phase 9+) ------------------------------------
# The app is not coupled to any single provider. Select one here.
# Supported values: none | anthropic | openai | custom
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- Feature flags ---------------------------------------------------------
# Browser-agent / form assistant layer is opt-in and off by default.
NEXT_PUBLIC_FEATURE_FORM_ASSISTANT=false
